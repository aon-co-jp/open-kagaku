[Unit]
Description=open-kagaku server (easy-web.tokyo/open-kagaku)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/easy-web.tokyo/open-kagaku/target/release
Environment=OPEN_KAGAKU_SERVER_BIND=127.0.0.1:8106
ExecStart=/root/easy-web.tokyo/open-kagaku/target/release/open-kagaku-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
